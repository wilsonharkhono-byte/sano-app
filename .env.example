# Copy this file to .env in the project root and fill in your Supabase credentials.
# NEVER commit .env to git.
EXPO_PUBLIC_SUPABASE_URL=https://example.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_KEY=<service-role-key>

# When 'on', Baseline upload offers the AI Normalizer step before parsing.
# Also set sanoBoqRecipeDetail=true in app.json extra to expose to the client.
SANO_BOQ_RECIPE_DETAIL=off

# Required for the Normalizer Edge Function (set in Supabase secrets, not here).
# ANTHROPIC_API_KEY=
