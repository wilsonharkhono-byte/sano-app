{
  "name": "san-contractor-supervisor",
  "version": "3.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "sync:materials": "node tools/syncMaterialCatalog.mjs",
    "sync:materials:watch": "node tools/syncMaterialCatalog.mjs --watch",
    "normalize:boq": "env -u ANTHROPIC_API_KEY tsx --env-file=.env tools/normalizer/cli.ts",
    "normalize:boq:det": "tsx tools/normalizer/cli-deterministic.ts",
    "normalize:boq:rollup": "tsx tools/normalizer/cli-rollup.ts",
    "test": "jest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-picker/picker": "^2.11.1",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/native": "^6.1.0",
    "@supabase/supabase-js": "^2.45.0",
    "babel-preset-expo": "~54.0.10",
    "base64-arraybuffer": "^1.0.2",
    "exceljs": "^4.4.0",
    "expo": "~54.0.35",
    "expo-asset": "~12.0.12",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.18",
    "pdf-lib": "^1.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "^0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "jest": "~29.7.0",
    "react-test-renderer": "^19.1.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.22.3",
    "typescript": "^5.5.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.jest.json"
        }
      ],
      "^.+\\.(js|jsx)$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|@testing-library/react-native|react-native-reanimated|react-native-gesture-handler|react-native-screens|react-native-safe-area-context|react-native-svg|@expo|expo|expo-modules-core)/)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "setupFiles": [
      "./jest.setup.js",
      "react-native/jest/setup"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.claude/worktrees/",
      "__tests__/fixtures\\.ts$",
      "__tests__/_serverGateHarness\\.ts$",
      "supabase/functions/",
      "tmp/"
    ]
  },
  "private": true
}
